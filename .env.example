# Required; generate strong unique random values and store only in Vercel Environment Variables.
STUDIO_ADMIN_PASSWORD=choose-a-long-random-password
STUDIO_SESSION_SECRET=choose-a-different-long-random-hmac-secret
# Auto-created by the connected private Vercel Blob store
BLOB_READ_WRITE_TOKEN=

# Optional PostgreSQL: once both values and the SQL migration are set, the backend
# automatically imports the last Blob snapshot to Supabase on first access.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
